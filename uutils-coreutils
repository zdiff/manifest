FROM manifest-base AS build-uutils-coreutils

ENV url="https://github.com/uutils/coreutils.git"
ENV version="0.9.0"

RUN git clone --branch "${version}" --single-branch --depth 1 "${url}" . \
    && cargo fetch --locked \
    && cargo build \
    --bins \
    --exclude uu_chcon \
    --exclude coreutils \
    --exclude uu_runcon \
    --exclude uu_stdbuf \
    --frozen \
    --profile release-small \
    --workspace \
    && mkdir bin \
    && find target/release-small/ -type f -maxdepth 1 -executable -exec mv -t bin/ {} + \
    && file bin/* 2>&1 | grep -q 'static-pie linked'

FROM scratch AS uutils-coreutils
WORKDIR /bin
COPY --from=build-uutils-coreutils /manifest/bin/ .