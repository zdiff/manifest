FROM rust:1.94-alpine AS build-alacritty

ENV PKG_CONFIG_ALL_STATIC=1
ENV url="https://github.com/alacritty/alacritty.git"
ENV version="v0.16.1"

WORKDIR /manifest

RUN apk add --no-cache \
    brotli-dev \
    brotli-static \
    bzip2-dev \
    bzip2-static \
    cmake \
    expat-dev \
    expat-static \
    file \
    fontconfig-dev \
    fontconfig-static \
    freetype-dev \
    freetype-static \
    git \
    libpng-dev \
    libpng-static \
    libxcb-dev \
    libxcb-static \
    pkgconf \
    python3 \
    zlib-dev \
    zlib-static \
    && git clone --branch "${version}" --single-branch --depth 1 "${url}" . \
    && cargo fetch --locked \
    && cargo build --frozen --release --verbose \
    && file target/release/alacritty  2>&1 | grep -q 'static-pie linked'

FROM scratch AS alacritty
WORKDIR /bin
COPY --from=build-alacritty /manifest/target/release/alacritty .