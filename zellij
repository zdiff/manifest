FROM manifest-base AS build-zellij

ENV url="https://github.com/zellij-org/zellij.git"
ENV version="v0.43.1"
ENV OPENSSL_NO_VENDOR=1

RUN apk add --no-cache \
    openssl-dev \
    openssl-libs-static \
    && git clone --branch "${version}" --single-branch --depth 1 "${url}" . \
    && cargo fetch --locked \
    && cargo build --frozen --release --verbose \
    && file target/release/zellij  2>&1 | grep -q 'static-pie linked'

FROM scratch AS zellij
WORKDIR /bin
COPY --from=build-zellij /manifest/target/release/zellij .